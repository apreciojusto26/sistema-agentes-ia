---
interface Props {
  tone?: 'grape' | 'gold' | 'graphite';
  class?: string;
}

const { tone = 'grape', class: className } = Astro.props;

const tones = {
  grape: 'bg-grape-tint text-grape',
  gold: 'bg-gold-tint text-gold',
  graphite: 'bg-graphite/5 text-graphite',
};
---

<span class:list={['inline-flex items-center gap-1 rounded-pill px-2.5 py-1 text-xs font-bold', tones[tone], className]}>
  <slot />
</span>
