---
import Container from '@/components/ui/Container.astro';
import { ICONS } from '@/lib/icons';
import { product } from '@/data/product';
import type { ComparisonRow } from '@/types/content';

const check = ICONS.check;
const cross = ICONS.cross;

// ANNOTATED, AND THE ANNOTATION IS LOAD-BEARING.
//
// `product` is `as const`, so without this the row type is whatever THIS
// product's data happens to be. A table whose `rival` is a string in every row
// gives `rival` a union of string literals — and then `typeof row.rival ===
// 'boolean'` narrows the row to `never`, so reading `row.rival` inside that
// branch is a type error. The component would compile for one product and fail
// for the next, with nothing about the component changed.
//
// `ComparisonRow` says what this component actually accepts: each cell is a
// boolean or a string, in every row, independently. That is the same state
// model ASTRAVIBE_FIXED_STRUCTURAL_GRAMMAR_V3 declares — nine reachable row
// states — and the type has to agree with it or the two describe different
// components.
const rows: readonly ComparisonRow[] = product.comparison;
const rowCount = rows.length;

// THE PRODUCT'S OWN LABEL. `product.brand` is null whenever the source
// published no maker, and this table named it twice — once as a heading and
// once as a column header. The name is factual and always present, so it is
// what an unbranded product is called here.
const label = product.brand ?? product.name;
---

<section class="bg-white py-12 md:py-16">
  <Container>
    <p class="text-eyebrow font-bold uppercase text-grape">Comparativa</p>
    {/* WAS "… vs. lámparas decorativas comunes" — the star projector's category,
        stated as this table's premise on every landing the template produces. A
        comparison whose rows are written per product cannot hardcode what they
        are compared against. */}
    <h2 class="mt-1 text-display md:text-4xl lg:text-5xl">{label} vs. las alternativas habituales</h2>

    <div class="mx-auto mt-6 grid max-w-4xl grid-cols-[1.3fr_1fr_1fr] overflow-hidden rounded-card text-sm">
      <div class="bg-surface p-3 font-semibold text-graphite">Característica</div>
      <div class="bg-grape-tint p-3 text-center font-semibold text-graphite">{label}</div>
      <div class="bg-white p-3 text-center font-semibold text-graphite">Otros</div>

      {
        rows.map((row, i) => {
          const isLast = i === rowCount - 1;
          return (
            <>
              <div class="border-t border-graphite/10 bg-surface p-3 text-graphite">{row.feature}</div>
              <div
                class:list={[
                  'border-t border-graphite/10 bg-grape-tint p-3 text-center text-graphite',
                  isLast && 'rounded-b-card',
                ]}
              >
                {typeof row.ours === 'boolean' ? (
                  <svg viewBox={row.ours ? check.viewBox : cross.viewBox} class="mx-auto size-5 text-grape" aria-hidden="true">
                    <path fill="currentColor" d={row.ours ? check.path : cross.path} />
                  </svg>
                ) : (
                  <span class="text-xs">{row.ours}</span>
                )}
              </div>
              <div class="border-t border-graphite/10 bg-white p-3 text-center text-graphite">
                {typeof row.rival === 'boolean' ? (
                  <svg viewBox={row.rival ? check.viewBox : cross.viewBox} class="mx-auto size-5 text-steel-light" aria-hidden="true">
                    <path fill="currentColor" d={row.rival ? check.path : cross.path} />
                  </svg>
                ) : (
                  <span class="text-xs">{row.rival}</span>
                )}
              </div>
            </>
          );
        })
      }
    </div>
  </Container>
</section>
