---
import Container from '@/components/ui/Container.astro';
import { FaqAccordion } from '@/components/islands/FaqAccordion';
import { faq } from '@/data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="scroll-mt-4 bg-white py-12 md:py-16">
  <Container>
    <div class="mx-auto max-w-3xl">
      <p class="text-eyebrow font-bold uppercase text-grape">Preguntas frecuentes</p>
      <h2 class="mt-1 text-[1.75rem] leading-tight md:text-4xl">Todo lo que necesitas saber</h2>

      <div class="mt-6">
        <FaqAccordion client:visible items={faq} />
      </div>
    </div>
  </Container>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
