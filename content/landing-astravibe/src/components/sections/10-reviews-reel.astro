---
import Container from '@/components/ui/Container.astro';
import WaveDivider from '@/components/ui/WaveDivider.astro';
import { ReviewCarousel } from '@/components/islands/ReviewCarousel';
import { testimonials } from '@/data/testimonials';
import { reviewerDisplayName } from '@/lib/reviewer-identity';

// DISPLAY NAMES ARE RESOLVED HERE, not inside the carousel.
//
// The carousel is an island: whatever it receives is serialized into the
// `<astro-island props="...">` attribute and shipped in the page source. A name
// derived client-side would render as `Cliente` while view-source still carried
// the raw marketplace mask, so resolution has to happen before the boundary.
// The raw author is untouched in src/data/testimonials.ts — the mask is
// provenance and is not destroyed, it is simply not published.
const reelReviews = testimonials
  .filter((t) => t.variant === 'reel')
  .map((t) => ({ ...t, author: reviewerDisplayName(t.author) }));
---

<div class="bg-white">
  <WaveDivider fill="grape-tint" />
</div>

{
  /*
    NO FACTUAL REVIEWS, NO SECTION.

    Social proof is projected from CanonicalProduct.socialProof.reviews, so a
    product whose provider published nothing usable has none — and this reel
    rendered its wrapper regardless, leaving an empty carousel and empty dots
    where evidence should be. 07-featured-testimonial.astro has guarded exactly
    this way since it was written; this now matches it.

    THE SECTION'S INSIDE IS UNTOUCHED: same wrapper, same classes, same
    carousel, same dots, same spacing. The only change is whether it exists,
    which ASTRAVIBE_FIXED_STRUCTURAL_GRAMMAR_V2 models as
    OPTIONAL<ReviewsSection>.

    THE WAVE DIVIDER ABOVE IS DELIBERATELY NOT GUARDED. It renders as
    `<div class="bg-white">`, and so does the hero's grid wrapper — two lines
    the structural matcher cannot tell apart, since it discriminates on tag,
    classes and attributes only. Making them distinguishable would mean
    changing markup that is present in every landing, which is exactly what the
    seal protects. So the divider stays: a decorative transition, no claim
    about anything, and the one thing an absent reviews section costs.
  */
}
{
  reelReviews.length > 0 && (
<div class="bg-grape-tint">
  <section class="mx-3 rounded-card bg-grape-tint py-10 md:mx-6 md:py-12 xl:mx-auto xl:max-w-[80rem]">
    <Container>
      <div class="mb-6 max-w-2xl">
        <p class="text-eyebrow font-bold uppercase text-grape">Opiniones</p>
        <h2 class="mt-1 text-[1.75rem] leading-tight md:text-4xl">Lo que dicen quienes ya lo tienen</h2>
        {/*
          Origin disclosure required by the Omnibus Directive (EU 2019/2161,
          transposed in RDL 24/2021): reviews sourced from another marketplace
          must not be presented as if they were left in this shop.
        */}
        {/*
          "compradores VERIFICADOS" was removed from this sentence. The
          disclosure existed to be honest about where the reviews come from,
          and it was making the one claim we cannot support in the very text
          meant to establish provenance: nothing upstream verifies that a
          reviewer purchased anything. What it says now is only what is true —
          these are reviews of this product, collected elsewhere.
        */}
        <p class="mt-3 text-sm text-graphite/70">
          Reseñas de compradores de este mismo producto, recopiladas de plataformas de venta online. No son opiniones
          dejadas en esta tienda.
        </p>
      </div>
      <div>
        <ReviewCarousel client:visible reviews={reelReviews} />
      </div>
    </Container>
  </section>
</div>
  )
}
