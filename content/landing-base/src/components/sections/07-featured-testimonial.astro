---
import PlaceholderShot from '@/components/ui/PlaceholderShot.astro';
import { testimonials } from '@/data/testimonials';

const featured = testimonials.find((t) => t.variant === 'quote');
---

{
  featured && (
    <section class="py-12 text-center md:py-16">
      <div class="mx-auto w-full max-w-[36rem] px-5 lg:max-w-[42rem]">
        <p class="font-display text-6xl text-rust/20" aria-hidden="true">
          &rdquo;
        </p>
        <p class="text-xl leading-snug text-graphite md:text-2xl">{featured.body}</p>

        <div class="mt-6 flex items-center justify-center gap-3">
          <div class="size-12 overflow-hidden rounded-full">
            <PlaceholderShot ratio="1/1" alt={featured.author} rounded="rounded-full" />
          </div>
          <div class="text-left">
            <p class="text-sm font-bold text-graphite">{featured.author}</p>
            {featured.verified && (
              <p class="flex items-center gap-1 text-xs font-semibold text-gold">
                <svg viewBox="0 0 20 20" class="size-3.5" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                  />
                </svg>
                Compra verificada
              </p>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}
