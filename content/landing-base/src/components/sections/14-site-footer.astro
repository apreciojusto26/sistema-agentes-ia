---
// The footer used to keep LABELS here and render every one of them as
// `<a href="#">` — one href in the whole file, ten dead links on every
// landing. Both halves now come from lib/navigation.ts, which the anchored
// SECTIONS import too, so a label can never point at an id nothing emits.
import Container from '@/components/ui/Container.astro';
import { product } from '@/data/product';
import { FOOTER_COLUMNS } from '@/lib/navigation';
---

<footer class="bg-graphite py-10 text-xs text-bone/70">
  <Container>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div>
        <span class="font-display text-lg font-black tracking-tight text-bone">
          {product.brand}<span class="align-super text-[0.6em] text-rust">™</span>
        </span>
      </div>
      {
        FOOTER_COLUMNS.map((column) => (
          <div>
            <p class="mb-2 font-semibold text-bone">{column.title}</p>
            <ul class="space-y-1.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="hover:text-bone">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 border-t border-white/10 pt-6 text-bone/50">
      Sitio de demostración. Producto, precios y reseñas son ilustrativos.
    </p>
  </Container>
</footer>
