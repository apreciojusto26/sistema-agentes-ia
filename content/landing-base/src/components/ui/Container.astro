---
// The shared page container. It now takes a `width` from the LAYOUT VOCABULARY
// rather than being one fixed max-width for every section on every landing.
//
// `contained` is the literal this file has always emitted, unchanged, so an
// unset width renders byte-identically and every frozen golden stays green.
import { containerClass, type SectionWidth } from '@/design-system/section-layout';

interface Props {
  class?: string;
  // `| undefined` explicitly: exactOptionalPropertyTypes is on, and callers
  // forward a value that is genuinely optional at the section instance.
  width?: SectionWidth | undefined;
}

const { class: className, width } = Astro.props;
---

<div class:list={[containerClass(width), className]}>
  <slot />
</div>
