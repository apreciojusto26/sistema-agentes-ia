---
import Base from '@/layouts/Base.astro';
import UtilityBar from '@/components/sections/01-utility-bar.astro';
import SiteHeader from '@/components/sections/02-site-header.astro';
import Hero from '@/components/sections/03-hero.astro';
import GalleryStrip from '@/components/sections/04-gallery-strip.astro';
import BuyBox from '@/components/sections/05-buy-box.astro';
import HowItWorks from '@/components/sections/06-how-it-works.astro';
import FeaturedTestimonial from '@/components/sections/07-featured-testimonial.astro';
import Faq from '@/components/sections/08-faq.astro';
import UgcStrip from '@/components/sections/09-ugc-strip.astro';
import ReviewsReel from '@/components/sections/10-reviews-reel.astro';
import Comparison from '@/components/sections/11-comparison.astro';
import Guarantee from '@/components/sections/12-guarantee.astro';
import RealResults from '@/components/sections/13-real-results.astro';
import SiteFooter from '@/components/sections/14-site-footer.astro';
import StickyBar from '@/components/sections/15-sticky-bar.astro';
import { CartDrawer } from '@/components/islands/CartDrawer';
import { getProductCommerce } from '@/lib/shopify/catalog';
import { product } from '@/data/product';

// SSR is enabled project-wide (astro.config.mjs `output:'server'`) for
// /checkout + /api/*. This is the one page that MUST stay static-prerendered
// — no LCP regression, no per-request server function for the landing page.
export const prerender = true;

const title = `${product.brand} — ${product.tagline}`;
const description = product.subtagline;

// Memoized in lib/shopify/catalog.ts — no extra network call even though
// 05-buy-box.astro and 15-sticky-bar.astro also await this.
const commerce = await getProductCommerce();
const defaultVariant = commerce.variants.find((v) => v.id === commerce.defaultVariantId) ?? commerce.variants[0];
---

<Base title={title} description={description}>
  <UtilityBar />
  <SiteHeader />
  <Hero />
  <GalleryStrip />
  <BuyBox />
  <HowItWorks />
  <FeaturedTestimonial />
  <Faq />
  <UgcStrip />
  <ReviewsReel />
  <Comparison />
  <Guarantee />
  <RealResults />
  <SiteFooter />
  <StickyBar />
  <CartDrawer client:load commerce={commerce} />

  {defaultVariant && (
    // is:inline can't `import` lib/analytics.ts, so this calls window.gtag
    // directly — Base.astro only defines it when GA is actually enabled.
    <script
      is:inline
      define:vars={{
        itemId: defaultVariant.id,
        itemName: commerce.title,
        price: defaultVariant.unitPriceCents / 100,
        currency: commerce.currencyCode,
      }}
    >
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'view_item', {
          currency: currency,
          value: price,
          items: [{ item_id: itemId, item_name: itemName, price: price, quantity: 1 }],
        });
      }
    </script>
  )}
</Base>
