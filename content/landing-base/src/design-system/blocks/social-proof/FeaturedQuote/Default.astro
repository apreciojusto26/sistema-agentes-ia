---
// DESIGN SYSTEM building block — socialProof/FeaturedQuote/default (Fase 2).
//
// Derives visually from @/components/sections/07-featured-testimonial.astro but
// is a SEPARATE component with a NEW capability type. The legacy section is
// never imported, wrapped or modified — a generation without --design keeps
// rendering it exactly as today.
//
// Prop `tone` is a DESIGN decision, never content. The quote itself still comes
// from @/data/testimonials, exactly as the legacy section does.
//
// Tailwind v4 scans SOURCE TEXT: every class is a complete literal string
// selected by lookup, never interpolated (see ADR-4).
import { testimonials } from '@/data/testimonials';
import { reviewerDisplayName } from '@/lib/reviewer-identity';

interface Props {
  tone?: 'light' | 'muted';
}

const { tone = 'light' } = Astro.props;

const SURFACE = {
  light: 'bg-surface',
  muted: 'bg-bone-dim',
} as const;

const QUOTE_MARK = {
  light: 'text-rust/20',
  muted: 'text-graphite/15',
} as const;

const BODY = {
  light: 'text-graphite',
  muted: 'text-graphite-soft',
} as const;

const surface = SURFACE[tone];
const quoteMark = QUOTE_MARK[tone];
const body = BODY[tone];

const featured = testimonials.find((t) => t.variant === 'quote');
---

{
  featured && (
    <section class:list={['py-12 text-center md:py-16', surface]}>
      <div class="mx-auto w-full max-w-[36rem] px-5 lg:max-w-[42rem]">
        <p class:list={['font-display text-6xl', quoteMark]} aria-hidden="true">
          &rdquo;
        </p>
        <p class:list={['text-xl leading-snug md:text-2xl', body]}>{featured.body}</p>

        <div class="mt-6 flex items-center justify-center">
          <div class="text-left">
            <p class="text-sm font-bold text-graphite">{reviewerDisplayName(featured.author)}</p>

          </div>
        </div>
      </div>
    </section>
  )
}
