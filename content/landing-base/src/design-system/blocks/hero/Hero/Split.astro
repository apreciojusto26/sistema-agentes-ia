---
// DESIGN SYSTEM building block — hero/Hero/split.
//
// Introduced at 19f60d5 as `hero/ProductHero/split`. It was never a second
// capability: it is a second COMPOSITION of the hero, and it was renamed to
// hero/Hero/split — file moved, markup untouched — when the taxonomy was
// unified. test-fixtures/legacy-markup/HeroSplitLeft.html and
// HeroSplitCenter.html were frozen from the 19f60d5 render BEFORE that move and
// are byte-compared on every run, which is what makes "untouched" a fact
// rather than a claim.
//
// Its sibling is Default.astro, which carries the legacy collage composition.
//
// STICKY CTA SENTINEL. The `<div id="hero-end">` at the bottom of this section
// is a functional contract EVERY hero/Hero variant owes the shell, not a design
// choice — which is why it takes no prop and no variant may opt out of it.
//
// 15-sticky-bar.astro passes sentinelId="hero-end" to StickyAddToCart, whose
// effect does `getElementById(sentinelId); if (!sentinel) return;`. With no
// sentinel there is no IntersectionObserver, `pastSentinel` stays false for the
// life of the page, and the bar keeps translate-y-full / aria-hidden / inert
// forever. The island still hydrates and still mounts: the CTA exists, is
// unreachable, and reports nothing. That is how this shipped unnoticed from
// 19f60d5 until the fix commit.
//
// Byte-identical to the element in Default.astro on purpose. If it ever needs
// to change, it changes in BOTH — a hero whose sentinel differs by variant is
// the same bug wearing a different mask.
//
// AND IT LIVES UP HERE, NOT BESIDE THE ELEMENT: Astro passes `<!-- -->` through
// to the rendered DOM, so an HTML comment would ship this paragraph into every
// generated landing. The golden caught exactly that on the first attempt.
//
// Prop `align` is a DESIGN decision, never content. All copy still arrives
// through @/data/product, exactly as the legacy hero does.
//
// Tailwind v4 (@tailwindcss/vite, CSS-first @theme) scans SOURCE TEXT for class
// names. Every class below is therefore a complete literal string selected by
// object lookup — never `class={`text-${align}`}`. An interpolated name is
// invisible to the scanner and silently produces no CSS.
import Container from '@/components/ui/Container.astro';
import Media from '@/components/ui/Media.astro';
import { product } from '@/data/product';
import { heroGallery } from './hero-gallery';

interface Props {
  align?: 'left' | 'center';
}

const { align = 'left' } = Astro.props;

const TEXT_ALIGN = {
  left: 'text-left',
  center: 'text-center',
} as const;

const PILLS_JUSTIFY = {
  left: 'justify-start',
  center: 'justify-center',
} as const;

const SUBTAGLINE_WIDTH = {
  left: 'max-w-prose',
  center: 'mx-auto max-w-prose',
} as const;

const textAlign = TEXT_ALIGN[align];
const pillsJustify = PILLS_JUSTIFY[align];
const subtaglineWidth = SUBTAGLINE_WIDTH[align];

const [primary] = heroGallery('split');
---

<section class="bg-bone pb-10 pt-6">
  <Container>
    <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-10">
      <div class={textAlign}>
        <h1 class="text-hero md:text-5xl xl:text-6xl">
          <span class="text-rust">{product.tagline}</span>
        </h1>

        <p class:list={['mt-3 text-base text-steel', subtaglineWidth]}>{product.subtagline}</p>

        <div class:list={['mt-6 flex flex-wrap gap-2', pillsJustify]}>
          {
            product.heroPills.map((pill) => (
              <span class="flex items-center gap-1.5 rounded-pill bg-white px-3 py-2 text-xs font-semibold text-graphite shadow-card">
                {pill}
              </span>
            ))
          }
        </div>
      </div>

      <div class="mt-8 lg:mt-0">
        {
          primary && (
            <div class="mx-auto w-full max-w-[26rem] rounded-card shadow-lift lg:max-w-none">
              <Media media={primary} rounded="rounded-card" />
            </div>
          )
        }
      </div>
    </div>
  </Container>

  <div id="hero-end" class="h-px w-full" aria-hidden="true"></div>
</section>
