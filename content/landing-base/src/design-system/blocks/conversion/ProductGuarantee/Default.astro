---
// DESIGN SYSTEM building block — conversion/ProductGuarantee/default (Fase 2).
//
// Derives visually from @/components/sections/12-guarantee.astro. It is an
// ADDITIONAL capability, NOT a replacement: conversion/Guarantee/default stays
// registered and keeps pointing at the legacy section, so a generation without
// --design renders 12-guarantee.astro exactly as today. This block never
// imports, wraps or modifies it.
//
// Prop `tone` is a DESIGN decision, never content. Guarantee copy, day count
// and points still come from @/data/product, exactly as the legacy section.
//
// Tailwind v4 scans SOURCE TEXT: every class is a complete literal string
// selected by lookup, never interpolated (see ADR-4).
import Container from '@/components/ui/Container.astro';
import { ICONS } from '@/lib/icons';
import { product } from '@/data/product';

interface Props {
  tone?: 'gold' | 'plain';
}

const { tone = 'gold' } = Astro.props;

const SURFACE = {
  gold: 'bg-gold-tint',
  plain: 'bg-bone',
} as const;

const ICON_COLOR = {
  gold: 'text-gold',
  plain: 'text-steel',
} as const;

const HEADING_COLOR = {
  gold: 'text-graphite',
  plain: 'text-graphite-soft',
} as const;

const surface = SURFACE[tone];
const iconColor = ICON_COLOR[tone];
const headingColor = HEADING_COLOR[tone];

const shield = ICONS.shield;
const { guarantee } = product;
---

<section class:list={['py-12 md:py-16', surface]}>
  <Container class="text-center">
    <img
      src="/sello-garantia.webp"
      width="112"
      height="112"
      alt={`Sello de garantía de ${guarantee.days} días`}
      class="mx-auto size-28"
      loading="lazy"
      decoding="async"
    />

    <h2 class:list={['mt-4 text-display md:text-4xl', headingColor]}>{guarantee.title}</h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-steel">{guarantee.text}</p>

    <div class="mx-auto mt-8 grid max-w-lg grid-cols-1 gap-3 sm:grid-cols-3">
      {
        guarantee.points.map((point) => (
          <div class="flex flex-col items-center gap-2 text-xs text-graphite">
            <svg viewBox={shield.viewBox} class:list={['size-6', iconColor]} aria-hidden="true">
              <path fill="currentColor" d={shield.path} />
            </svg>
            <span>{point}</span>
          </div>
        ))
      }
    </div>
  </Container>
</section>
