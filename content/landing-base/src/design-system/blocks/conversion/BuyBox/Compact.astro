---
// DESIGN SYSTEM building block — conversion/BuyBox/compact.
//
// Sibling of Card.astro, not a stripped version of it. Both mount an island
// that reaches the SAME useBuyAction(), so the transaction is identical down to
// the variant id, the quantity, the analytics payload and the CTA decision.
// What differs is what a buy box IS in the composition:
//
//   card     a lifted card surface. Rating over title over scarcity pill,
//            packs as a vertical stack of bordered tiles, payment logos, two
//            trust lines, and a 2x4 grid of benefit tiles at the bottom.
//   compact  no outer surface at all. One trust line instead of three blocks,
//            packs as a horizontal segmented control, and NO benefit tiles.
//
// THE MISSING TILES ARE THE POINT, not an omission. card renders
// product.benefits itself, which was fine while it was the only thing that did.
// Now product/Benefits/{icon-grid,feature-list} exist, and a landing composing
// card WITH them shows every benefit twice — verified on a real build before
// this variant was written. compact is the composition that lets a landing use
// the real Benefits capability without repeating it, and the registry states
// that as an incompatibility rather than leaving it to the agent's judgement.
//
// Every class is a complete literal in a static `class="..."` attribute.
import { CompactBuySelector } from '@/components/islands/CompactBuySelector';
import { getProductCommerce } from '@/lib/shopify/catalog';
import Stars from '@/components/ui/Stars.astro';
import { product } from '@/data/product';
import { buyBoxDisplay, BUYBOX_SCARCITY_LABEL, BUYBOX_GIFT_LABEL } from './buy-box-data';

const commerce = await getProductCommerce();
const { giftThresholdUnits, ratingLabel, ratingCountLabel } = buyBoxDisplay('compact');
---

<section id="buy" class="scroll-mt-14 mx-auto w-full max-w-[28rem] px-5 md:max-w-[42rem] lg:max-w-[64rem] py-8">
  <div class="border-y border-graphite/10 py-6">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <h2 class="text-display">{commerce.title}</h2>
      <div class="flex items-center gap-2">
        <Stars rating={product.ratingAverage} />
        <span class="text-xs font-semibold text-graphite">{ratingLabel}/5 ({ratingCountLabel})</span>
        <span class="rounded-pill bg-rust-tint px-2.5 py-1 text-xs font-bold text-rust">{BUYBOX_SCARCITY_LABEL}</span>
      </div>
    </div>

    <div class="mt-5">
      <CompactBuySelector
        client:visible
        commerce={commerce}
        packs={[...product.packs]}
        bundleOfferActive={product.commerce.bundleOfferActive}
        variantGroupLabel={product.variantGroupLabel}
        cta={{
          primary: product.cta.primary,
          checkout: product.cta.checkout,
          pending: product.cta.pending,
          soldOut: product.cta.soldOut,
        }}
        errors={product.errors}
        giftThresholdUnits={giftThresholdUnits}
        giftLabel={BUYBOX_GIFT_LABEL}
      />
    </div>

    <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-steel">
      <span class="flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" class="size-4 text-rust" aria-hidden="true"><path fill="currentColor" d="M3 6a1 1 0 011-1h9a1 1 0 011 1v3h2.5a1 1 0 01.8.4l2.5 3.33a1 1 0 01.2.6V16a1 1 0 01-1 1h-1.17a2.5 2.5 0 01-4.66 0H9.83a2.5 2.5 0 01-4.66 0H4a1 1 0 01-1-1V6z"/></svg>
        {product.shipping.etaLabel}
      </span>
      <span class="flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" class="size-4 text-gold" aria-hidden="true"><path fill="currentColor" d="M12 2l8 3.5v5.25c0 5.06-3.4 9.62-8 11.25-4.6-1.63-8-6.19-8-11.25V5.5L12 2z"/></svg>
        {product.guarantee.title}
      </span>
    </p>
  </div>
</section>
