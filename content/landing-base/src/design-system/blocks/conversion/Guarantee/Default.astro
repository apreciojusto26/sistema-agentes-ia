---
// DESIGN SYSTEM building block — conversion/Guarantee/default.
//
// THIRD and last of the 19f60d5 duplicate types to be collapsed, after
// hero/ProductHero folded into hero/Hero and socialProof/FeaturedQuote folded
// into socialProof/FeaturedTestimonial. That commit's own message named the
// arrangement out loud: "conversion/Guarantee/default keeps resolving next to
// conversion/ProductGuarantee/default". Two entries, one component.
//
// A NOTE ON THE PROSE ABOVE, because it cost an hour. An ASCII arrow written
// as hyphen-then-greater-than, inside a frontmatter comment ABOVE `interface
// Props`, silently breaks Astro's props inference: `Astro.props` degrades to
// `any`, every lookup below becomes an implicit-any error, and `Props` reports
// as unused. Isolated with a five-file minimal repro; the same characters are
// harmless BELOW the interface, and the `<!-- -->` sequence in Hero/Split.astro
// does not trigger it. Write "folded into" in this region, not the arrow.
//
// It was measured before it was merged. Rendered against the same frozen input
// the legacy section and this block emitted 30 elements each, the same tag
// sequence, and byte-identical markup once class attributes were stripped. The
// only differences were colour tokens. A dial, not a composition.
//
// AND IT WAS WORSE THAN THE OTHER TWO. Both types carried
// id={SECTION_ANCHORS.Guarantee}, so a DesignSpec naming both validated, built,
// and shipped a page with TWO id="guarantee" elements repeating the same
// promise word for word, with the footer's href="#guarantee" resolving to
// whichever came first. Deleting the duplicate type is what fixes that; no
// incompatibleWith rule was added, because the combination is no longer
// expressible by the catalogue at all.
//
// WHAT THIS SECTION SAYS NOW COMES FROM MERCHANT CONFIG, NOT FROM THE MODEL.
// It used to read product.guarantee — days, title, text and a points list, all
// written by the Content Agent with no source behind any of it. It asserted
// "Garantía de 30 días" while merchant.returnsWindowDays said 14, and it
// promised "Reembolso completo, sin preguntas", conditions nobody configured.
// Facts now arrive through lib/policy.ts and the words are derived from them.
//
// THE RETURNS WINDOW IS NOT CALLED A GUARANTEE. They are different promises:
// one is how long you have to send it back, the other is an additional
// commitment the merchant may or may not have made. The heading says
// "Devoluciones durante N días"; a guarantee line appears ONLY when
// commercialGuaranteeDays is configured, and its absence means absence.
//
// THE GOLD SEAL IMAGE IS GONE. public/sello-garantia.webp has "GARANTIA 30
// DIAS" baked into its pixels — inspected, not inferred from the filename — so
// it contradicted any merchant whose window was not 30 and could never be
// derived from config. It is replaced by ICONS.shield, the primitive the points
// row already used: no number, no policy claim, nothing to keep in sync.
//
// PREVIEW renders NOTHING here. With no merchant there are no policy facts, and
// a guarantee section with no facts is decoration that invites a default. The
// legal pages already degrade this way.
//
// Every tone is a COMPLETE class string, never a base plus an appended token.
// Tailwind v4 scans source text, so each literal must be whole (ADR-4); and
// writing them out in full is also what gives `gold` exact control over
// attribute order.
import Container from '@/components/ui/Container.astro';
import { SECTION_ANCHORS } from '@/lib/navigation';
import { ICONS } from '@/lib/icons';
import {
  policy,
  returnsHeadline,
  returnShippingLine,
  commercialGuaranteeHeadline,
} from '@/lib/policy';

interface Props {
  tone?: 'gold' | 'plain';
}

// `gold` is the default because it is the legacy surface. An omitted prop must
// reproduce what shipped, never introduce a surface nobody asked for.
const { tone = 'gold' } = Astro.props;

const SECTION = {
  gold: 'bg-gold-tint py-12 md:py-16',
  plain: 'py-12 md:py-16 bg-bone',
} as const;

const HEADING = {
  gold: 'mt-4 text-display md:text-4xl',
  plain: 'mt-4 text-display md:text-4xl text-graphite-soft',
} as const;

const ICON = {
  gold: 'size-6 text-gold',
  plain: 'size-6 text-steel',
} as const;

const CREST = {
  gold: 'mx-auto size-20 text-gold',
  plain: 'mx-auto size-20 text-steel',
} as const;

const section = SECTION[tone];
const heading = HEADING[tone];
const icon = ICON[tone];
const crest = CREST[tone];

const shield = ICONS.shield;

// Derived once, so the section cannot disagree with itself. `guaranteeLine` is
// null unless the merchant configured an additional commercial guarantee.
const facts = policy;
const headline = facts ? returnsHeadline(facts) : null;
const shippingCost = facts ? returnShippingLine(facts) : null;
const guaranteeLine = facts ? commercialGuaranteeHeadline(facts) : null;
---

{
  facts && (
    <section id={SECTION_ANCHORS.Guarantee} class={section}>
      <Container class="text-center">
        <svg viewBox={shield.viewBox} class={crest} role="img" aria-label={headline}>
          <path fill="currentColor" d={shield.path} />
        </svg>

        <h2 class={heading}>{headline}</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-steel">{shippingCost}</p>

        {guaranteeLine && (
          <div class="mx-auto mt-8 flex max-w-lg items-center justify-center gap-2 text-xs text-graphite">
            <svg viewBox={shield.viewBox} class={icon} aria-hidden="true">
              <path fill="currentColor" d={shield.path} />
            </svg>
            <span>{guaranteeLine}</span>
          </div>
        )}
      </Container>
    </section>
  )
}
