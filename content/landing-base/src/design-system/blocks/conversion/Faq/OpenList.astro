---
// DESIGN SYSTEM building block — conversion/Faq/open-list.
//
// The SAME questions and answers as Accordion.astro, every one of them open.
// Sibling variant: same faqItems() accessor, same framing copy, same
// requiresData. No answer is truncated and no copy is rewritten.
//
// STRUCTURALLY different, not re-skinned:
//   - no island: Accordion mounts FaqAccordion with `client:visible` for its
//     open/close state. Nothing here hydrates, so index.html carries no
//     <astro-island> for this section and the browser never requests that
//     chunk. (The chunk is still EMITTED — index.astro's
//     `import.meta.glob({eager:true})` bundles every registered candidate.
//     Unreferenced, so unloaded.)
//   - no expansion controls: no <button>, no aria-expanded, no aria-controls,
//     no chevron, no collapsible region.
//   - a real definition list. <dl>/<dt>/<dd> is the semantically correct
//     element for question/answer pairs and is what the accordion cannot use,
//     since each of its rows needs an interactive trigger inside a heading.
//   - every answer is laid out at once, so the section's height is its content
//     rather than a fixed row of triggers.
//
// ON CONTENT PRESENCE — the honest version. This variant does NOT put more
// text into the HTML than the accordion does: FaqAccordion collapses with
// `grid-rows-[0fr]`, so its answers are already in the document. What changes
// is that here they are also VISIBLE without interaction, with no
// CSS-dependent reveal and no JS required to read them. That is the real,
// verifiable difference; anything stronger would be an SEO claim this file
// cannot back up.
//
// Tailwind v4 scans SOURCE TEXT: every class below is a complete literal
// string, never interpolated or concatenated (ADR-4, guarded by
// contract.design-blocks.test.ts B2).
import Container from '@/components/ui/Container.astro';
import { SECTION_ANCHORS } from '@/lib/navigation';
import { faqItems, FAQ_EYEBROW, FAQ_HEADING } from './faq-items';
import { rhythmClass, type SectionWidth, type SectionRhythm } from '@/design-system/section-layout';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const items = faqItems('open-list');

// LAYOUT VOCABULARY (P0 vertical slice). `width` and `rhythm` arrive from the
// SECTION INSTANCE in the DesignSpec, not from this capability's propsSchema:
// how wide this section is and how much air it gets are properties of the page,
// and this block genuinely does not care. See design-system/section-layout.ts.
//
// Unset renders byte-identically to before — `contained` and `standard` are the
// literals this file already had.
interface Props {
  width?: SectionWidth;
  rhythm?: SectionRhythm;
}

const { width, rhythm } = Astro.props;

// The baseline is this block's own literal, so `standard` and an unset
// rhythm both render exactly what it rendered before.
const sectionRhythm = rhythmClass(rhythm, 'py-12 md:py-16');
---

<section id={SECTION_ANCHORS.Faq} class={sectionRhythm}>
  <Container width={width}>
    <SectionHeader eyebrow={FAQ_EYEBROW} title={FAQ_HEADING} />

    <dl class="mx-auto mt-6 grid max-w-3xl grid-cols-1 gap-x-8 gap-y-6 md:max-w-5xl md:grid-cols-2">
      {
        items.map((item) => (
          <div class="border-t border-graphite/10 pt-4">
            <dt class="font-semibold text-graphite">{item.question}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-steel">{item.answer}</dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
