---
// DESIGN SYSTEM building block — product/HowItWorks/vertical-steps.
//
// The SAME steps as HorizontalTimeline.astro, read top to bottom.
// Sibling variant: same howItWorksSteps() accessor, same framing copy, same
// requiresData, same authored `step` numbers.
//
// STRUCTURALLY different, not re-skinned — and different at EVERY breakpoint,
// which is the point. The timeline is already a vertical stack below `lg`, so
// a variant that only differed on mobile would differ in nothing:
//   - ONE column always. No `lg:grid-cols-3`, no breakpoint where the steps
//     sit side by side.
//   - a numbered rail instead of an overlay badge: the step number is its own
//     column, aligned down the left edge, so the sequence is readable as a
//     numbered process without looking at the images.
//   - media BESIDE the copy from `md` up rather than above it, so a step is
//     one horizontal band instead of a tall card — three stacked 4:3 cards is
//     a long scroll, three bands is not.
//   - an ordered list. <ol>/<li> is the correct element for a sequence and is
//     what the card grid cannot use, since its cards are not authored as an
//     ordered sequence in the DOM.
//
// NO INTERACTION, in either variant. There is no island here and none in the
// timeline: this section explains a process, it does not track one. No
// progress state, no percentages, no current-step highlighting — inventing any
// of that would be reading a tracker into an explanation.
//
// The `step` number is AUTHORED DATA (`step.step`), never the array index, so
// renumbering cannot happen here.
//
// Tailwind v4 scans SOURCE TEXT: every class below is a complete literal
// string, never interpolated or concatenated (ADR-4, guarded by
// contract.design-blocks.test.ts B2).
import Container from '@/components/ui/Container.astro';
import Media from '@/components/ui/Media.astro';
import { howItWorksSteps, STEPS_EYEBROW, STEPS_HEADING } from './steps';

const steps = howItWorksSteps('vertical-steps');
---

<section class="bg-bone-dim py-12 md:py-16">
  <Container>
    <p class="text-eyebrow font-bold uppercase text-rust">{STEPS_EYEBROW}</p>
    <h2 class="mt-1 text-display md:text-4xl lg:text-5xl">{STEPS_HEADING}</h2>

    <ol class="mx-auto mt-8 max-w-3xl space-y-6">
      {
        steps.map((step) => (
          <li class="flex gap-4 border-t border-graphite/10 pt-6 md:gap-6">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-graphite font-display font-black text-bone">
              {step.step}
            </span>

            <div class="flex min-w-0 flex-1 flex-col gap-4 md:flex-row md:items-start md:gap-6">
              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-bold text-graphite">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-steel">{step.text}</p>
              </div>
              <div class="w-full shrink-0 md:w-52">
                <Media media={step.media} rounded="rounded-tile" class="aspect-[4/3] w-full" />
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
