---
import '@/styles/global.css';
// Imported AFTER global.css so the family/density scopes land later in the
// cascade. Kept out of global.css on purpose — see that file's header: the
// generator's patchThemeBlock() regex-matches token declarations across the
// whole of global.css, so redeclaring them there would weaken its
// fail-closed check.
import '@/styles/design-system.css';
import { getSecret } from 'astro:env/server';
import { design } from '@/data/design';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const ogImage = new URL('/og-cover.png', Astro.site ?? Astro.url).toString();

// Gated to prod so local/preview traffic doesn't pollute GA4/Clarity data.
const gaId = import.meta.env.PROD ? getSecret('PUBLIC_GA_MEASUREMENT_ID') : undefined;
const clarityId = import.meta.env.PROD ? getSecret('PUBLIC_CLARITY_PROJECT_ID') : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          // define:vars wraps this script in an IIFE, so `gtag` is scoped to
          // it — exposed explicitly so lib/analytics.ts can reach it.
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    {clarityId && (
      <script is:inline define:vars={{ clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clarityId);
      </script>
    )}
  </head>
  <!-- Design System Fase 3: the DesignSpec's `design.family` / `design.density`
       become real CSS scopes here. global.css redefines @theme tokens under
       [data-design-family] and the Tailwind v4 `--spacing` base under
       [data-density], so every downstream utility shifts without a single
       component edit. Attributes are emitted ALWAYS (never conditionally) so
       the rendered markup is a pure function of the spec. -->
  <body data-design-family={design.design.family} data-density={design.design.density}>
    <slot />
  </body>
</html>
