---
// NO ANALYTICS TAG IS EMITTED BY THIS LAYOUT ANY MORE.
//
// GA4 and Microsoft Clarity used to be inserted straight into the <head>
// below, gated only by `import.meta.env.PROD && <id configured>` — so a
// production landing loaded both, and fired view_item, on first paint with no
// interaction and no consent. Clarity is a session recorder.
//
// They are now injected by lib/analytics-loader.ts, and only after the visitor
// accepts. The UI that lets someone accept lands in the very next commit;
// until it does, analytics simply never loads.
//
// AND THIS NOTE LIVES IN THE FRONTMATTER, NOT BESIDE THE ELEMENT: Astro passes
// `<!-- -->` straight through to the rendered DOM, so an HTML comment here
// would ship this paragraph into every generated landing. It did, until a
// build grep caught the word `view_item` still in the output — coming from the
// comment that explains its removal.
import '@/styles/global.css';
// Imported AFTER global.css so the family/density scopes land later in the
// cascade. Kept out of global.css on purpose — see that file's header: the
// generator's patchThemeBlock() regex-matches token declarations across the
// whole of global.css, so redeclaring them there would weaken its
// fail-closed check.
import '@/styles/design-system.css';
import { design } from '@/data/design';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const ogImage = new URL('/og-cover.png', Astro.site ?? Astro.url).toString();

// The GA4 / Clarity ids are no longer read here: lib/analytics-loader.ts
// reads them from PUBLIC_ env in the browser, after consent.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Both files are WRITTEN PER LANDING by generate-landing.mjs's write-favicon
      stage from the brand and the resolved theme — the template ships none, so
      an output can never silently wear a shared icon. SVG first for modern
      browsers; the ICO is the fallback and carries 16x16 and 32x32.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  </head>
  <!-- Design System Fase 3: the DesignSpec's `design.family` / `design.density`
       become real CSS scopes here. global.css redefines @theme tokens under
       [data-design-family] and the Tailwind v4 `--spacing` base under
       [data-density], so every downstream utility shifts without a single
       component edit. Attributes are emitted ALWAYS (never conditionally) so
       the rendered markup is a pure function of the spec. -->
  <body data-design-family={design.design.family} data-density={design.design.density}>
    <slot />
  </body>
</html>
