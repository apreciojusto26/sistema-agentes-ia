---
// Carrier AND delivery estimate both from merchant config now.
//
// The estimate used to come from `product.shipping.etaLabel`, described here as
// "where it already lived". It lived there without a source: the scraper
// supplies no shipping signal, so every estimate was copied from the Content
// Agent's few-shot example. This page then presented it as "una estimación del
// transportista" — an attribution nobody could support, since the carrier never
// said it. Both the field and that sentence are gone.
import LegalPage from '@/layouts/LegalPage.astro';
import { merchant } from '@/data/merchant';

// Same as index.astro: this is a static page, not a per-request function.
export const prerender = true;
---
<LegalPage title="Envíos" intro="Cómo y cuándo se entrega tu pedido.">
  {merchant && (
    <>
      <h2 class="text-lg font-bold">Transporte</h2>
      <p>Los pedidos se entregan a través de {merchant.carrierName}.</p>

      <h2 class="text-lg font-bold">Plazo de entrega</h2>
      <p>
        El plazo de entrega indicado por la tienda es:
        <strong>{merchant.shippingEtaLabel}</strong>. Es una estimación y puede variar
        según el destino.
      </p>

      <h2 class="text-lg font-bold">Incidencias</h2>
      <p>
        Si tu pedido no llega en el plazo estimado, escribinos a{' '}
        <a class="text-rust underline" href={`mailto:${merchant.contactEmail}`}>{merchant.contactEmail}</a>{' '}
        indicando tu número de pedido.
      </p>
    </>
  )}
</LegalPage>
