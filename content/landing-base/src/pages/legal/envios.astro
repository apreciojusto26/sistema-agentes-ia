---
// Carrier from merchant config; the delivery estimate from product content
// (`product.shipping.etaLabel`), which is where it already lived. No free
// shipping claim, no "24/48 h" — neither is configured anywhere.
import LegalPage from '@/layouts/LegalPage.astro';
import { merchant } from '@/data/merchant';
import { product } from '@/data/product';

// Same as index.astro: this is a static page, not a per-request function.
export const prerender = true;
---
<LegalPage title="Envíos" intro="Cómo y cuándo se entrega tu pedido.">
  {merchant && (
    <>
      <h2 class="text-lg font-bold">Transporte</h2>
      <p>Los pedidos se entregan a través de {merchant.carrierName}.</p>

      <h2 class="text-lg font-bold">Plazo de entrega</h2>
      <p>
        El plazo estimado para este producto es: <strong>{product.shipping.etaLabel}</strong>.
        Es una estimación del transportista y puede variar según el destino.
      </p>

      <h2 class="text-lg font-bold">Incidencias</h2>
      <p>
        Si tu pedido no llega en el plazo estimado, escribinos a{' '}
        <a class="text-rust underline" href={`mailto:${merchant.contactEmail}`}>{merchant.contactEmail}</a>{' '}
        indicando tu número de pedido.
      </p>
    </>
  )}
</LegalPage>
