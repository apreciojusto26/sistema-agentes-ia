---
import Base from '@/layouts/Base.astro';
import { ViewItem } from '@/components/islands/ViewItem';
import UtilityBar from '@/components/sections/01-utility-bar.astro';
import SiteHeader from '@/components/sections/02-site-header.astro';
import SiteFooter from '@/components/sections/14-site-footer.astro';
import StickyBar from '@/components/sections/15-sticky-bar.astro';
import { CartDrawer } from '@/components/islands/CartDrawer';
import { getProductCommerce } from '@/lib/shopify/catalog';
import { product } from '@/data/product';
import { design } from '@/data/design';
import { resolveCapability } from '@/design-system/registry';

// SSR is enabled project-wide (astro.config.mjs `output:'server'`) for
// /checkout + /api/*. This is the one page that MUST stay static-prerendered
// — no LCP regression, no per-request server function for the landing page.
export const prerender = true;

const title = `${product.brand} — ${product.tagline}`;
const description = product.subtagline;

// --- flexible content area (Design System Fase 2) -------------------------
//
// The SHELL above/below stays statically imported and in fixed order — it is
// not addressable through sections[] and never will be (agents.MD §5.3). Only
// the flexible content area is driven by the DesignSpec.
//
// `import.meta.glob({ eager: true })` is statically analyzable, so Vite bundles
// every candidate at build time and `prerender = true` above still holds. A
// runtime `import()` would not — do not "simplify" this into one.
const MODULES = {
  ...import.meta.glob('@/components/sections/*.astro', { eager: true }),
  ...import.meta.glob('@/design-system/blocks/**/*.astro', { eager: true }),
} as Record<string, { default: unknown }>;

// Registry `component` values are authored as `@/...`; the glob keys come back
// as project-root-relative paths. One normalization, in one place.
const moduleByPath = new Map(
  Object.entries(MODULES).map(([key, mod]) => [key.replace(/^.*\/src\//, '@/'), mod]),
);

const sections = [...design.sections].sort((a, b) => a.order - b.order);

// Fail-closed (design guiding principle): an unresolvable capability or a
// missing component file STOPS the build. It must never be silently skipped
// and must never fall back to another registered capability — a landing that
// quietly drops a section is worse than one that refuses to build.
const resolved = sections.map((section) => {
  const key = `${section.category}/${section.type}/${section.variant}`;

  const entry = resolveCapability(section.category, section.type, section.variant);
  if (!entry) {
    throw new Error(
      `DesignSpec section ${section.order} names an unregistered capability "${key}". ` +
        `No substitution is performed. Register it in src/design-system/registry.ts ` +
        `(and scripts/lib/design-registry.mjs — the parity test enforces both) or remove the section.`,
    );
  }

  const mod = moduleByPath.get(entry.component);
  if (!mod) {
    throw new Error(
      `Capability "${key}" resolves to "${entry.component}", which no component file matches. ` +
        `Expected it under src/components/sections/ or src/design-system/blocks/.`,
    );
  }

  // LAYOUT rides on the section INSTANCE, so it is merged in here rather than
  // coming out of the capability's propsSchema. A block that does not accept
  // width/rhythm simply ignores them — this is the vertical slice, not a
  // migration of all 21.
  return {
    Component: mod.default as any,
    props: { ...(section.props ?? {}), ...(section.layout ?? {}) },
  };
});

// Deliberately AFTER the section resolution: a malformed DesignSpec should
// fail the build before we spend a Shopify round-trip on it.
// Memoized in lib/shopify/catalog.ts — no extra network call even though
// 05-buy-box.astro and 15-sticky-bar.astro also await this.
const commerce = await getProductCommerce();
const defaultVariant = commerce.variants.find((v) => v.id === commerce.defaultVariantId) ?? commerce.variants[0];
---

<Base title={title} description={description}>
  <UtilityBar />
  <SiteHeader />

  {resolved.map(({ Component, props }) => <Component {...props} />)}

  <SiteFooter />
  <StickyBar />
  <CartDrawer client:load commerce={commerce} />

  {defaultVariant && (
    <ViewItem
      client:idle
      itemId={defaultVariant.id}
      itemName={commerce.title}
      price={defaultVariant.unitPriceCents / 100}
      currency={commerce.currencyCode}
    />
  )}
</Base>
